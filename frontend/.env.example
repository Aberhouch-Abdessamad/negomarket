# Laravel API origin (no trailing slash). Use "localhost", not 127.0.0.1, so Sanctum cookies work.
VITE_API_URL=http://localhost:8000
VITE_APP_NAME=NegoMarket

# Must match REVERB_APP_KEY / REVERB_HOST / REVERB_PORT / REVERB_SCHEME in backend/.env
VITE_REVERB_APP_KEY=change-me-reverb-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
